# Copy to .env and fill in what you use. Never commit .env.

# Minimum risk score (0-100) that triggers storage, enrichment and alerts
RISK_THRESHOLD=60

# Certificate Transparency feeds: primary first, then comma-separated fallbacks
CERTSTREAM_URL=wss://certstream.calidog.io
CERTSTREAM_FALLBACK_URLS=
# Switch to the next feed after this many seconds without a certificate
CERTSTREAM_IDLE_TIMEOUT_SECONDS=60

# DNS enrichment
ENABLE_DNS_ENRICHMENT=true
DNS_TIMEOUT_SECONDS=3.0

# urlscan.io sandbox (optional)
ENABLE_URLSCAN=false
URLSCAN_API_KEY=

# Webhook alerts (optional)
ENABLE_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Storage
DATABASE_PATH=detections.db
REPORTS_DIR=reports
