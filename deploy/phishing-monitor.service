[Unit]
Description=Indian Bank Phishing Domain Monitor - Ingestion & Triage Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=phishmon
Group=phishmon
WorkingDirectory=/opt/indian-bank-phishing-domain-monitor
EnvironmentFile=/opt/indian-bank-phishing-domain-monitor/.env
ExecStart=/opt/indian-bank-phishing-domain-monitor/.venv/bin/python -m src.main --stream
Restart=always
RestartSec=10
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
